# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# CREDENCIAIS OFICIAIS DO DISCORD DEVELOPER
# ==========================================

# 1. DISCORD_CLIENT_ID: ID da sua Aplicação no Discord
# Encontrado em: Discord Developer Portal > General Information / OAuth2 > Client ID
DISCORD_CLIENT_ID="MY_DISCORD_CLIENT_ID"

# 2. DISCORD_CLIENT_SECRET: Segredo do Cliente para autenticação OAuth2
# Encontrado em: Discord Developer Portal > OAuth2 > General > Client Secret (Reset Secret)
DISCORD_CLIENT_SECRET="MY_DISCORD_CLIENT_SECRET"

# 3. DISCORD_BOT_TOKEN: Token do Bot para controle e criação de canais/cargos
# Encontrado em: Discord Developer Portal > Bot > Token (Reset Token)
DISCORD_BOT_TOKEN="MY_DISCORD_BOT_TOKEN"

# 4. DISCORD_GUILD_ID: ID do Servidor Discord onde o bot irá operar
# Encontrado clicando com botão direito no servidor no Discord > Copiar ID do Servidor
DISCORD_GUILD_ID="MY_DISCORD_GUILD_ID"
